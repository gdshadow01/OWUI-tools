#### Qdrant ####
QDRANT_HOST=qdrant_master
QDRANT_PORT=6333
QDRANT_COLLECTION=testing

# embedding
EMBEDDING_MODEL_NAME=snowflake-embed-l-v2.0-GGUF

VECTOR_SIZE=1024
    # Snowflake Arctic embed -> 1024 dimensions
    # Qwen3-Embedding-0.6B-GGUF -> 1024
    # Qwen3-Embedding-4b-GGUF -> 2560

## chunking
MAX_CHUNK_SIZE=600  #tokens
MIN_CHUNK_SIZE=200
CHUNK_OVERLAP=100  # reserved — not implemented (paragraph-based chunking; see RAG/01 config.py)

### MCP or openai
      # set to 'mcp' or 'openapi'
TRANSPORT_TYPE=openapi

#### Provider ####
# Set to "openai" for OpenAI-compatible services (like llama.cpp) or "ollama" for Ollama
PROVIDER=openai

# OpenAI-compatible settings (used when PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here

# BASE_URL: fast host used for ingestion (RAG/01) AND may co-host the main LLM.
# Loading the embedding model here is acceptable because ingestion is batch work.
# http(s)://ip_or_domain/v1
OPENAI_BASE_URL=

# RETRIEVAL_URL: dedicated host for the embedding model, used at query time by
# RAG/02 retrieval. Set this in prod so retrieval does NOT hit BASE_URL (which
# would unload the main LLM). Falls back to BASE_URL if unset.
OPENAI_RETRIEVAL_URL=

# Ollama settings (used when PROVIDER=ollama)
OLLAMA_BASE_URL=http://ollama:11434  # Code default (host.docker.internal:11434) is a last-resort fallback only; set this explicitly in .env


#### Agents - deprecated ####
# API for agents (separate from embedding/retrieval)
LLM_API_KEY=your-openai-api-key-here

# local for testing
LLM_API_URL=
LLM_MODEL_NAME=gpt-oss-20b-Q8

# production
#LLM_API_URL=https://api.mistral.ai/v1/chat/completions
#LLM_MODEL_NAME=mistral-small-latest


APP_BASE_PATH=/app

#### Reranker add-on (RAG/02 reranker.py) ####
# Optional, OFF unless RERANK_ENABLED is truthy (1/true/yes/on).
# Reranks search/search_by_file via a decision model behind llama-swap;
# disabled or unreachable => retrieval results are returned unchanged.
RERANK_ENABLED=false
# llama-swap base URL (root), e.g. http://<llama-swap-host>:<port>
RERANK_BASE_URL=
# llama-swap profile id (the literal model id clients route by)
RERANK_MODEL=
# reranker HTTP budget in seconds (hard cap per search call)
RERANK_TIMEOUT_S=3.0
# optional wider candidate fetch (Qdrant RRF limit), cut back to top_k after
# scoring; unset/empty = rerank the returned top_k in place
RERANK_CANDIDATES=
