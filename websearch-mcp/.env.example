# tika server
TIKA_SERVER_URL=http://tika:9998
# control search engines
USE_SEARXNG_SEARCH=yes
# searngx url
SEARXNG_URL=http://searxng:8080
# other settings
PAGE_FETCH_TIMEOUT=15
PAGE_MAX_CONTENT_LENGTH=50000
SEARXNG_TIMEOUT=15
# mcp server bind
MCP_HOST=0.0.0.0
MCP_PORT=9200
# Allowed Host header values for the MCP server's DNS-rebinding protection
# (equivalent to Starlette TrustedHostMiddleware). "*" disables protection and
# allows any host — use this when the server is reachable from other hosts/LAN.
# Otherwise set a comma-separated list of allowed hosts; each entry may use ":*"
# as a port wildcard, e.g. ALLOWED_HOSTS=192.168.0.209:*,localhost:*
ALLOWED_HOSTS=*

# tiered fetch escalation (tier 1 curl_cffi stealth, tier 2 browser CDP sidecar)
USE_BROWSER_TIER=yes
BROWSER_CDP_URL=http://browser:9222
ESCALATION_TIMEOUT=45

# reddit .rss backend (anonymous feeds, ~1 request/min/IP, shared gate + cache)
USE_REDDIT_BACKEND=yes
REDDIT_MIN_INTERVAL=65
REDDIT_CACHE_TTL=600
