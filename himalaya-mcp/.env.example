# MCP server bind
MCP_HOST=0.0.0.0
MCP_PORT=9201

# Himalaya config
# Directory containing config.toml (server resolves config.toml inside it)
HIMALAYA_CONFIG_DIR=/config
# Account name to use for tools when no explicit `account` arg is given.
# Leave EMPTY to let himalaya auto-select the account marked `default = true`
# in config.toml. Set only if you need to override the default.
DEFAULT_ACCOUNT=
DRAFTS_FOLDER=Drafts
# Destination folder for draft_delete's move-to-trash
TRASH_FOLDER=Trash

# Attachment export policy
# 20 MB = wrapper parity (check-mail.py MAX_ATTACHMENT_BYTES); refuse-over, never truncate
ATTACHMENT_MAX_BYTES=20971520
# himalaya subprocess timeout in seconds for attachment download (big payloads, slow servers)
ATTACHMENT_DL_TIMEOUT=120

# Allowed Host header values for FastMCP's DNS-rebinding protection
# (Starlette TrustedHostMiddleware-equivalent). "*" disables protection and
# allows any host; otherwise a comma-separated list of allowed host values.
# Each entry may use a ":*" suffix as a port wildcard, e.g. "192.168.0.209:*".
ALLOWED_HOSTS=*
